# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Comma-separated list of admin email addresses for RIKZEN Admin Console RBAC
ADMIN_EMAILS="gungaming05@gmail.com"

# Optional: Remove.bg API key to enable server-side AI background removal
REMOVEBG_API_KEY=""

# File processing limits & temporary storage retention
MAX_UPLOAD_MB="100"
MAX_FILE_SIZE_MB="100"
MAX_FILES_PER_BATCH="50"
MAX_TOTAL_BATCH_SIZE_MB="1000"
MAX_PROCESSING_TIME_MS="120000"
MAX_CONCURRENT_JOBS="4"
TEMP_FILE_TTL_MINUTES="30"

# QR Generator media upload limits & per-user persistent vault quota
MAX_QR_IMAGE_SIZE_MB="25"
MAX_QR_VIDEO_SIZE_MB="100"
MAX_QR_FILE_SIZE_MB="50"
MAX_QR_STORAGE_PER_USER_MB="500"
