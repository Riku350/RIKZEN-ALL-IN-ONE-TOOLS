rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gungaming05@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'theme', 'language', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'theme', 'language', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.role in ['user', 'admin']
        && data.theme in ['light', 'dark', 'system']
        && data.language in ['en', 'hi', 'hinglish']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserFile(data) {
      return data.keys().hasAll(['id', 'userId', 'fileName', 'mimeType', 'sizeBytes', 'toolId', 'category', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'fileName', 'mimeType', 'sizeBytes', 'originalSizeBytes', 'toolId', 'category', 'serverFileId', 'expiresAt', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255
        && data.mimeType is string && data.mimeType.size() <= 120
        && data.sizeBytes is number && data.sizeBytes >= 0
        && (!('originalSizeBytes' in data) || (data.originalSizeBytes is number && data.originalSizeBytes >= 0))
        && data.toolId is string && data.toolId.size() >= 1 && data.toolId.size() <= 80
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && (!('serverFileId' in data) || (data.serverFileId is string && data.serverFileId.size() <= 128))
        && (!('expiresAt' in data) || data.expiresAt is timestamp)
        && data.createdAt is timestamp;
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['id', 'userId', 'toolId', 'toolName', 'category', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'toolId', 'toolName', 'category', 'fileName', 'inputSizeBytes', 'outputSizeBytes', 'status', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.toolId is string && data.toolId.size() >= 1 && data.toolId.size() <= 80
        && data.toolName is string && data.toolName.size() >= 1 && data.toolName.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255))
        && (!('inputSizeBytes' in data) || (data.inputSizeBytes is number && data.inputSizeBytes >= 0))
        && (!('outputSizeBytes' in data) || (data.outputSizeBytes is number && data.outputSizeBytes >= 0))
        && data.status in ['completed', 'failed']
        && data.createdAt is timestamp;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['userId', 'toolId', 'createdAt'])
        && data.keys().hasOnly(['userId', 'toolId', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.toolId is string && data.toolId.size() >= 1 && data.toolId.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'active', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'message', 'active', 'createdAt'])
        && data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 600
        && data.active is bool
        && data.createdAt is timestamp;
    }

    function isValidToolConfig(data) {
      return data.keys().hasAll(['toolId', 'enabled', 'maxFileSizeMb', 'updatedAt'])
        && data.keys().hasOnly(['toolId', 'enabled', 'maxFileSizeMb', 'updatedAt'])
        && data.toolId is string && data.toolId.size() >= 1 && data.toolId.size() <= 80
        && data.enabled is bool
        && data.maxFileSizeMb is number && data.maxFileSizeMb >= 1 && data.maxFileSizeMb <= 100
        && data.updatedAt is timestamp;
    }

    function isValidQrCode(data) {
      return data.keys().hasAll(['id', 'userId', 'shareId', 'name', 'qrType', 'payload', 'shareUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'shareId', 'name', 'qrType', 'payload', 'shareUrl', 'mimeType', 'fileName', 'sizeBytes', 'thumbnailUrl', 'designJson', 'expiresAtMs', 'createdAt', 'updatedAt'])
        && data.id is string && isValidId(data.id)
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.shareId is string && isValidId(data.shareId) && data.shareId.size() >= 8 && data.shareId.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.qrType in ['link', 'text', 'contact', 'wifi', 'email', 'phone', 'location', 'image', 'video', 'file']
        && data.payload is string && data.payload.size() <= 4000
        && data.shareUrl is string && data.shareUrl.size() <= 1000
        && (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 120))
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255))
        && (!('sizeBytes' in data) || (data.sizeBytes is number && data.sizeBytes >= 0))
        && (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000))
        && (!('designJson' in data) || (data.designJson is string && data.designJson.size() <= 4000))
        && (!('expiresAtMs' in data) || (data.expiresAtMs is number && data.expiresAtMs >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().role == 'user'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUser(incoming(), userId)
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'theme', 'language', 'updatedAt'])
            && incoming().role == existing().role
            && incoming().uid == existing().uid
            && incoming().email == existing().email
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /files/{fileId} {
      allow get: if isValidId(fileId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(fileId)
        && isSignedIn()
        && isValidUserFile(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(fileId)
        && isSignedIn()
        && existing().userId == request.auth.uid
        && isValidUserFile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['fileName'])
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(fileId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /tool_history/{historyId} {
      allow get: if isValidId(historyId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(historyId)
        && isSignedIn()
        && isValidHistory(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(historyId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /favorites/{favoriteId} {
      allow get: if isValidId(favoriteId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(favoriteId)
        && isSignedIn()
        && isValidFavorite(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(favoriteId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    match /tool_configs/{toolId} {
      allow get, list: if true;
      allow create, update: if isValidId(toolId) && isAdmin() && isValidToolConfig(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isValidId(toolId) && isAdmin();
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list, write: if false;
    }

    match /qr_codes/{qrId} {
      allow get: if isValidId(qrId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(qrId)
        && isSignedIn()
        && isValidQrCode(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(qrId)
        && isSignedIn()
        && existing().userId == request.auth.uid
        && isValidQrCode(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'payload', 'designJson', 'expiresAtMs', 'updatedAt'])
        && incoming().userId == existing().userId
        && incoming().shareId == existing().shareId
        && incoming().qrType == existing().qrType
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(qrId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
